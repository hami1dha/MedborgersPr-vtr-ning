    function startTimer() { if(timerInterval) stopTimer(); timerInterval = setInterval(() => { if(!quizActive) return; if(timeLeft <= 1) { timeLeft=0; updateTimerDisplay(); stopTimer(); quizActive=false; finishQuiz("timeout"); } else { timeLeft--; updateTimerDisplay(); } }, 1000); }
    function updateTimerDisplay() { let el = document.getElementById("timerValue"); if(el) el.innerText = formatTime(timeLeft); }
    function showFeedback(isCorrect, correctAnswerText) { let fb = document.getElementById("feedbackBox"); if(!fb) return; fb.innerHTML = isCorrect ? `✅ Rigtigt! Svaret "${correctAnswerText}" er korrekt.` : `❌ Forkert. Det rigtige svar er: "${correctAnswerText}".`; fb.className = `feedback ${isCorrect ? "correct" : "wrong"}`; }
    
    function loadQuestion() {
        let q = quizData[currentQuestion];
        document.getElementById("questionText").innerText = q.question;
        document.getElementById("counterSpan").innerText = `${currentQuestion+1}/${TOTAL_QS}`;
        let container = document.getElementById("answersContainer");
        container.innerHTML = "";
        q.answers.forEach((ans, idx) => {
            let div = document.createElement("div");
            div.classList.add("answer");
            div.innerText = ans;
            div.onclick = () => {
                if(hasAnswered) return;
                document.querySelectorAll(".answer").forEach(a=>a.classList.remove("selected"));
                div.classList.add("selected");
                let isCorrect = (idx === q.correct);
                if(isCorrect) score++;
                showFeedback(isCorrect, q.answers[q.correct]);
                hasAnswered = true;
                document.querySelectorAll(".answer").forEach(a=>a.style.pointerEvents = "none");
            };
            container.appendChild(div);
        });
        hasAnswered = false;
        let fb = document.getElementById("feedbackBox");
        if(fb) { fb.innerHTML = "⚡ Klik på et svar – du får det rigtige svar med det samme."; fb.className = "feedback"; }
        document.getElementById("nextButton").disabled = false;
    }
    function nextQuestion() {
        if(!quizActive) return;
        if(!hasAnswered) { alert("Vælg et svar før du går videre!"); return; }
        if(currentQuestion + 1 < TOTAL_QS) { currentQuestion++; loadQuestion(); }
        else { finishQuiz("completed"); }
    }
    function finishQuiz(reason) {
        quizActive = false; stopTimer();
        appRoot.innerHTML = `<div class="inner-padding" style="text-align:center;"><h2 style="border-left:none;">${reason==="timeout"?"⏰ Tiden er gået":"🏁 Quiz gennemført"}</h2><div class="score-circle">${score}/${TOTAL_QS} rigtige</div><p>${reason==="timeout"?`Du nåede ${currentQuestion} spørgsmål.`:"Godt klaret – du har øvet dig til medborgerskabsprøven!"}</p><button onclick="resetAndShowDescriptionWithPayment()">🔄 Ny prøve (betaling kræves igen)</button><footer>100 spørgsmål / 50 minutter – efter betaling</footer></div>`;
    }
    function launchQuiz() {
        if(sessionStorage.getItem("quiz_paid") !== "true") { showDescriptionAndPayment(); return; }
        currentQuestion=0; score=0; timeLeft=TIME_LIMIT_SEC; hasAnswered=false; quizActive=true;
        appRoot.innerHTML = `<div class="timer-bar"><span class="question-counter">📋 Spørgsmål <span id="counterSpan">0/${TOTAL_QS}</span></span><span class="timer">⏱️ <span id="timerValue">${formatTime(timeLeft)}</span></span></div><div class="inner-padding"><h2 id="questionText">Indlæser...</h2><div class="answers-container" id="answersContainer"></div><div id="feedbackBox" class="feedback"></div><button id="nextButton">Næste spørgsmål →</button><footer>📖 Rigtigt svar efter hvert valg – 100 spørgsmål / 50 min</footer></div>`;
        startTimer(); loadQuestion(); document.getElementById("nextButton").onclick = nextQuestion;
    }

    // Ny funktion: Beskrivelse + betalingsknap (efter man har læst)
    function showDescriptionAndPayment() {
        sessionStorage.removeItem("quiz_paid");
        appRoot.innerHTML = `
            <div class="inner-padding description-screen">
                <h1>🇩🇰 Forberedelse til Medborgerskabsprøven</h1>
                <div style="text-align:center;">
                    <span class="description-badge">100 spørgsmål • 50 minutter • Fuld feedback</span>
                </div>
                <div class="description-text">
                    <strong>📘 Hvad får du med denne øvelsesprøve?</strong>
                    <ul>
                        <li>✅ 100 autentiske spørgsmål om dansk demokrati, grundlov, velfærd, EU, historie og kultur.</li>
                        <li>✅ Øjeblikkelig feedback – efter hvert svar ser du det rigtige svar og lærer undervejs.</li>
                        <li>✅ Tidsstyring – 50 minutters nedtælling, der simulerer den virkelige prøve.</li>
                        <li>✅ Mulighed for at gentage quizzen lige så mange gange du vil (betales én gang).</li>
                        <li>✅ Designet til at styrke din viden om danske værdier og samfundsforhold.</li>
                    </ul>
                    <p><strong>🎯 Hvorfor netop denne quiz?</strong><br>
                    Den officielle medborgerskabsprøve stiller krav om bred viden. Vores quiz giver dig den nødvendige træning i et realistisk format – du lærer af dine fejl og opbygger selvtillid.</p>
                    <p style="margin-top:12px;"><strong>💰 Kun 49 kr. – én gang.</strong> Efter betaling har du adgang til hele prøven, og du kan tage den igen og igen i din browser (indtil du sletter cookies).</p>
                </div>
                <div style="text-align:center;">
                    <div class="price-tag">49 kr.</div>
                    <button id="stripePayBtn" class="stripe-pay-btn">💳 Gå til betaling med Stripe</button>
                    <div class="stripe-brand" style="margin-top:8px;">⚡ Sikker betaling – kort / MobilePay</div>
                </div>
                <p class="payment-note">* Du sendes til Stripe’s betalingsvindue. Efter gennemført betaling skal du vende tilbage og trykke på “Jeg har betalt”.</p>
                <footer>Træning til den officielle medborgerskabsprøve – opdater din viden om Danmark</footer>
            </div>
        `;
        const stripeBtn = document.getElementById("stripePayBtn");
        stripeBtn.addEventListener("click", () => {
            window.open(STRIPE_PAYMENT_LINK, "_blank");
            // Erstat knappen med bekræftelsesknap
            const container = document.querySelector(".description-screen");
            const paymentContainer = document.querySelector(".description-screen .price-tag").parentNode;
            paymentContainer.innerHTML = `
                <div style="background:#e8f0fe; padding:18px; border-radius:48px; margin:15px 0;">
                    ✅ Stripe betalingsside åbnet.<br>
                    <strong>Gennemfør betalingen i det nye vindue.</strong><br>
                    Klik nedenfor når betaling er gennemført.
                </div>
                <button id="confirmPaymentBtn" style="background:#2e7d32; width:100%;">🔓 Jeg har betalt – giv mig adgang</button>
            `;
            document.getElementById("confirmPaymentBtn").addEventListener("click", () => {
                sessionStorage.setItem("quiz_paid", "true");
                alert("✅ Betaling registreret! Du får nu adgang til quizzen med 100 spørgsmål.");
                showDescriptionAndPayment(); // genindlæser beskrivelsen, men nu med "Du har betalt" + startknap
                // Ændr visningen til at vise startknap i stedet for betalingsknap
                const descDiv = document.querySelector(".description-text");
                if(descDiv) {
                    const oldContainer = document.querySelector(".description-screen .price-tag")?.parentNode;
                    if(oldContainer) {
                        oldContainer.innerHTML = `
                            <div class="price-tag">✔️ Adgang aktiveret</div>
                            <button id="startAfterPaymentBtn" style="background:#0f6b3a; margin-top:10px;">🚀 Start quiz nu (100 spørgsmål / 50 min)</button>
                        `;
                        document.getElementById("startAfterPaymentBtn").addEventListener("click", launchQuiz);
                    }
                }
            });
        });
    }

    // Hvis betaling allerede er registreret, vis beskrivelse med startknap (uden betaling)
    function showDescriptionWithStart() {
        appRoot.innerHTML = `
            <div class="inner-padding description-screen">
                <h1>🇩🇰 Medborgerskabsprøven – klar til start</h1>
                <div style="text-align:center;">
                    <span class="description-badge">100 spørgsmål • 50 minutter • Fuld feedback</span>
                </div>
                <div class="description-text">
                    <strong>🎉 Du har allerede betalt!</strong><br><br>
                    Klik på knappen nedenfor for at gå i gang med quizzen. Du har 50 minutter til at besvare 100 spørgsmål. Efter hvert svar får du det rigtige svar vist.
                </div>
                <div style="text-align:center;">
                    <button id="startQuizBtn" class="start-btn" style="background:#0f6b3a; font-size:1.2rem;">🚀 Start quiz (100 spørgsmål / 50 min)</button>
                </div>
                <footer>God fornøjelse – lær og bliv klar til den officielle prøve</footer>
            </div>
        `;
        document.getElementById("startQuizBtn").onclick = launchQuiz;
    }

    window.resetAndShowDescriptionWithPayment = function() {
        sessionStorage.removeItem("quiz_paid");
        showDescriptionAndPayment();
    };

    // Initial visning: hvis betalt → vis startskærm med startknap, ellers beskrivelse + betaling
    if(sessionStorage.getItem("quiz_paid") === "true") {
        showDescriptionWithStart();
    } else {
        showDescriptionAndPayment();
    }
</script>
</body>
</html>
