        font-size: 2rem;
        color: #0c4e6e;
        margin-bottom: 0.75rem;
        text-align: center;
    }
    .description-badge {
        background: #0077b6;
        color: white;
        display: inline-block;
        padding: 6px 20px;
        border-radius: 80px;
        font-weight: 600;
        margin: 10px 0;
    }
    .description-text {
        background: #f8fafc;
        padding: 22px;
        border-radius: 28px;
        margin: 20px 0;
        line-height: 1.55;
        font-size: 1rem;
        border: 1px solid #e2edf7;
    }
    .description-text ul {
        padding-left: 1.5rem;
        margin: 12px 0;
    }
    .price-tag {
        font-size: 1.8rem;
        font-weight: 800;
        background: #eef2fc;
        display: inline-block;
        padding: 8px 28px;
        border-radius: 60px;
        margin: 10px 0;
    }
    .stripe-pay-btn {
        background: #635bff;
        background-image: linear-gradient(135deg, #635bff 0%, #8a60ff 100%);
        color: white;
        border: none;
        padding: 14px 24px;
        font-size: 1.2rem;
        font-weight: bold;
        border-radius: 60px;
        cursor: pointer;
        width: 100%;
        transition: 0.2s;
        margin-top: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }
    .stripe-pay-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(99, 91, 255, 0.3);
    }
    .payment-note {
        font-size: 0.75rem;
        color: #6c7e97;
        text-align: center;
        margin-top: 20px;
    }

    /* Quiz styling (som før) */
    .timer-bar {
        background: #f8fafc;
        border-bottom: 1px solid #e2edf7;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 12px;
        padding: 14px 30px;
    }
    .timer {
        font-size: 1.7rem;
        font-family: monospace;
        background: #0b2b3f;
        color: #f0f9ff;
        padding: 5px 15px;
        border-radius: 60px;
    }
    .question-counter {
        background: #eef3fc;
        padding: 6px 18px;
        border-radius: 40px;
        color: #1e4a76;
        font-weight: 600;
    }
    h2 {
        font-size: 1.7rem;
        margin: 0 0 1rem 0;
        color: #0c344b;
        border-left: 5px solid #0077b6;
        padding-left: 20px;
        text-align: left;
    }
    .answers-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin: 20px 0;
    }
    .answer {
        background: #f1f5f9;
        border-radius: 60px;
        padding: 12px 20px;
        cursor: pointer;
        border: 1px solid #e0e9f2;
        transition: 0.2s;
        font-weight: 500;
    }
    .answer:hover {
        background: #e4edf6;
        transform: translateX(5px);
    }
    .selected {
        background: #cfe3fc !important;
        border-left: 6px solid #0077b6;
    }
    .feedback {
        margin-top: 18px;
        padding: 14px 18px;
        border-radius: 28px;
        background: #f0f5fa;
        font-size: 0.95rem;
    }
    .feedback.correct {
        background: #e0f2e9;
        border-left: 5px solid #2e7d64;
    }
    .feedback.wrong {
        background: #ffe9e9;
        border-left: 5px solid #c7362b;
    }
    button {
        margin-top: 20px;
        padding: 14px;
        width: 100%;
        border: none;
        background: #0077b6;
        color: white;
        font-weight: bold;
        font-size: 1rem;
        border-radius: 60px;
        cursor: pointer;
        transition: 0.2s;
    }
    button:hover {
        background: #025e91;
        transform: translateY(-2px);
    }
    .score-circle {
        font-size: 2.8rem;
        font-weight: 800;
        background: #eef2fa;
        display: inline-block;
        padding: 15px 35px;
        border-radius: 100px;
        margin: 20px 0;
    }
    footer {
        font-size: 0.7rem;
        margin-top: 20px;
        text-align: center;
        color: #5d6f83;
    }
