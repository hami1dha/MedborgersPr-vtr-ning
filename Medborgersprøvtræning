        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .quiz-card {
        background: white;
        border-radius: 2rem;
        max-width: 850px;
        width: 100%;
        box-shadow: 0 25px 45px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    .inner-padding {
